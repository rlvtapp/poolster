def _integer(value,field,incoming):
    unsigned=field.type in (field.TYPE_UINT64,field.TYPE_FIXED64)
    low,high=(0,2**64-1) if unsigned else (-(2**63),2**63-1)
    if incoming:
        if _POLICY['int64']=='string':return str(value)
        if _POLICY['int64']=='numberExact':
            converted=float(value)
            if int(converted)!=value:raise ValueError('Lossy int64 number conversion')
            return converted
        return value
    if _POLICY['int64']=='string':
        import re
        if not isinstance(value,str) or not re.fullmatch('-?(0|[1-9][0-9]*)',value):raise ValueError('Invalid int64 string')
        value=int(value)
    elif _POLICY['int64']=='numberExact':
        if not isinstance(value,float) or not value.is_integer():raise ValueError('Expected exact integral number')
        value=int(value)
    if not isinstance(value,int) or isinstance(value,bool) or not low<=value<=high:raise ValueError('int64 outside native bounds')
