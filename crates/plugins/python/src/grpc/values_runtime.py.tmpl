def field_value(field,value,incoming):
    if field.is_repeated:
        if field.message_type and field.message_type.GetOptions().map_entry:
            key_field,value_field=field.message_type.fields
            if incoming:
                entries=[(scalar(key_field,key,True),scalar(value_field,value[key],True)) for key in value]
                return entries if _POLICY['maps']=='entries' else dict(entries)
            pairs=value if _POLICY['maps']=='entries' else value.items()
            result={}
            for key,item in pairs:
                key=scalar(key_field,key,False)
                if key in result:raise ValueError('Duplicate map representation key')
                result[key]=scalar(value_field,item,False)
            return result
        return [scalar(field,item,incoming) for item in value]
    return scalar(field,value,incoming)

def default(full_name,field_name):
    field=native(full_name).DESCRIPTOR.fields_by_name[field_name]
    if field.is_repeated:return [] if not field.message_type or not field.message_type.GetOptions().map_entry or _POLICY['maps']=='entries' else {}
    if field.has_presence:return None if _POLICY['optional']=='nullable' else UNSET
    return scalar(field,getattr(native(full_name)(),field_name),True)

def _from_native(cls,value):
    if not isinstance(value,cls._native_type):raise TypeError('Wrong native message type')
    arguments={}
    for field in value.DESCRIPTOR.fields:
        if field.has_presence and not value.HasField(field.name):continue
        arguments[field.name]=field_value(field,getattr(value,field.name),True)
    result=cls(**arguments);result._native=_clone(value);return result

def _to_native(value):
    result=_clone(value._native) if value._native is not None else value._native_type()
    active=set()
    for field in result.DESCRIPTOR.fields:
        public=getattr(value,field.name)
        result.ClearField(field.name)
        if isinstance(public,Unset) or (public is None and field.has_presence):continue
        if field.containing_oneof:
            oneof=field.containing_oneof.name
            if oneof in active:raise ValueError('Multiple oneof alternatives supplied')
            active.add(oneof)
        converted=field_value(field,public,False)
        if field.is_repeated:
            target=getattr(result,field.name)
            if field.message_type and field.message_type.GetOptions().map_entry:
                if field.message_type.fields_by_name['value'].message_type:
                    for key,item in converted.items():target[key].CopyFrom(item)
                else:target.update(converted)
            else:target.extend(converted)
        elif field.message_type:getattr(result,field.name).CopyFrom(converted)
        else:setattr(result,field.name,converted)
    _wire._check_depth(result)
    return result


def _convert(function,*arguments):
    depth=_DEPTH.get()
    if depth>_wire._MAX_DEPTH:raise ValueError('Value model exceeds maxDepth')
    token=_DEPTH.set(depth+1)
    try:return function(*arguments)
    finally:_DEPTH.reset(token)
def from_native(cls,value):return _convert(_from_native,cls,value)
def to_native(value):return _convert(_to_native,value)
