export interface RpcHttpOptions {fetch?:typeof globalThis.fetch;headers?:HeadersInit;signal?:AbortSignal;timeoutMs?:number;}
export class RpcHttpError extends Error {constructor(public readonly code:string,public readonly details:string,public readonly metadata:Headers=new Headers()){super(details);this.name='RpcHttpError';}}
