fter gRPC-web trailers');yield payload;}else throw new RpcHttpError('unimplemented','Compressed or unknown gRPC-web frame');}}if(buffer.length||!trailers)throw new RpcHttpError('internal','Truncated gRPC-web response or missing trailers');}finally{await reader?.cancel().catch(()=>{});reader?.releaseLock();ctx.close();}}
