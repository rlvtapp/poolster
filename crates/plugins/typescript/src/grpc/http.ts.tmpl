export async function twirp(url:string,body:Uint8Array,options:RpcHttpOptions={}):Promise<Uint8Array>{const ctx=context(options);try{const response=await(options.fetch??globalThis.fetch)(url,{method:'POST',headers:{...Object.fromEntries(new Headers(options.headers)), 'content-type':'application/protobuf'},body:body as BodyInit,signal:ctx.signal});if(!response.ok){const error=await response.json() as {code?:string,msg?:string,meta?:Record<string,string>};throw new RpcHttpError(error.code??'unknown',error.msg??response.statusText,new Headers(error.meta));}return new Uint8Array(await response.arrayBuffer());}finally{ctx.close();}}
