export interface MessageAdapter<N,V>{toNative(value:V):N;fromNative(value:N):V;}
export interface BinaryCodec<N>{encode(value:N):Uint8Array;decode(bytes:Uint8Array):N;}
export function adaptMessage<N,V>(codec:BinaryCodec<N>,adapter:MessageAdapter<N,V>):BinaryCodec<V>{return{encode:value=>codec.encode(adapter.toNative(value)),decode:bytes=>adapter.fromNative(codec.decode(bytes))};}
export function safeNumber(value:bigint):number{const result=Number(value);if(!Number.isSafeInteger(result)||BigInt(result)!==value)throw new RangeError('Integer exceeds JavaScript safe precision');return result;}
export function int64(value:number):bigint{if(!Number.isSafeInteger(value))throw new RangeError('Expected a safe integer');const result=BigInt(value);if(result<-(1n<<63n)||result>=(1n<<63n))throw new RangeError('int64 outside wire range');return result;}
export function uint64(value:number):bigint{if(value<0)throw new RangeError('uint64 cannot be negative');return int64(value);}
export function timestampToDate(value:{seconds:bigint;nanos:number}):Date{if(value.seconds< -62135596800n||value.seconds>253402300799n||!Number.isInteger(value.nanos)||value.nanos<0||value.nanos>=1e9)throw new RangeError('Timestamp outside wire range');if(value.nanos%1e6)throw new RangeError('Date cannot preserve timestamp nanoseconds');const result=new Date(safeNumber(value.seconds*1000n)+value.nanos/1e6);if(!Number.isFinite(result.getTime()))throw new RangeError('Timestamp outside Date range');return result;}
export function dateToTimestamp(value:Date):{seconds:bigint;nanos:number}{const milliseconds=value.getTime();if(!Number.isFinite(milliseconds))throw new RangeError('Invalid Date');const seconds=BigInt(Math.floor(milliseconds/1000));const nanos=(milliseconds-Number(seconds)*1000)*1e6;const result={seconds,nanos};timestampToDate(result);return result;}
export function durationToMilliseconds(value:{seconds:bigint;nanos:number}):number{if(value.seconds< -315576000000n||value.seconds>315576000000n||!Number.isInteger(value.nanos)||Math.abs(value.nanos)>=1e9||(value.seconds>0n&&value.nanos<0)||(value.seconds<0n&&value.nanos>0))throw new RangeError('Invalid Duration');if(value.nanos%1e6)throw new RangeError('Milliseconds cannot preserve duration nanoseconds');return safeNumber(value.seconds*1000n)+value.nanos/1e6;}
