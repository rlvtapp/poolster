import type {RpcContext,RpcUnary} from './poolster-rpc-facade.js';
export function batchLoader<I,K,O>(key:(input:I)=>K,invoke:(keys:K[])=>RpcUnary<O[]>,max:number,cacheEnabled:boolean,outputKey?:((output:O)=>K)) {
 type Entry={key:K;resolve:(value:O)=>void;reject:(error:unknown)=>void;active:boolean;cleanup:()=>void;};
 let queue:Entry[]=[];let scheduled=false;let disposed=false;const cache=new Map<K,O>();const pending=new Set<Entry>();
 async function flush(){scheduled=false;const entries=queue.filter(e=>e.active);queue=[];for(let start=0;start<entries.length;start+=max){const part=entries.slice(start,start+max);try{const response=await invoke(outputKey?[...new Set(part.map(e=>e.key))]:part.map(e=>e.key));let values:O[];if(outputKey){const index=new Map<K,O>();for(const value of response){const k=outputKey(value);if(index.has(k))throw new Error('Duplicate batch association key');index.set(k,value);}values=part.map(e=>{if(!index.has(e.key))throw new Error('Missing batch association key');return index.get(e.key)!;});}else{if(response.length!==part.length)throw new Error('Batch response count differs from request');values=response;}part.forEach((entry,i)=>{if(entry.active){if(cacheEnabled)cache.set(entry.key,values[i]);entry.resolve(values[i]);}});}catch(error){part.forEach(e=>{if(e.active)e.reject(error);});}finally{part.forEach(e=>{e.active=false;e.cleanup();pending.delete(e);});}}}
 function load(input:I,signal?:AbortSignal):Promise<O>{if(disposed)return Promise.reject(new Error('Batch scope is closed'));if(signal?.aborted)return Promise.reject(signal.reason??new DOMException('Aborted','AbortError'));const k=key(input);if(cacheEnabled&&cache.has(k))return Promise.resolve(cache.get(k)!);return new Promise((resolve,reject)=>{const entry:Entry={key:k,resolve,reject,active:true,cleanup:()=>signal?.removeEventListener('abort',abort)};const abort=()=>{entry.active=false;entry.cleanup();pending.delete(entry);reject(signal?.reason??new DOMException('Aborted','AbortError'));};signal?.addEventListener('abort',abort,{once:true});queue.push(entry);pending.add(entry);if(!scheduled){scheduled=true;queueMicrotask(()=>void flush());}});}
 return {load,close(){disposed=true;cache.clear();for(const entry of pending){entry.active=false;entry.cleanup();entry.reject(new Error('Batch scope is closed'));}pending.clear();queue=[];}};
}
