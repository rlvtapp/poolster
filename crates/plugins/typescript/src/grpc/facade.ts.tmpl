export function upload<I,O>(invoke:(metadata:Metadata,options:CallOptions,callback:(error:ServiceError|null,value:O)=>void)=>ClientWritableStream<I>,source:AsyncIterable<I>|Iterable<I>,context:RpcContext={}):RpcUnary<O> {
