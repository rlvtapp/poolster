import {Metadata,type CallOptions,type ClientUnaryCall,type ClientReadableStream,type ClientWritableStream,type ClientDuplexStream,type StatusObject,type ServiceError} from '@grpc/grpc-js';
export interface RpcContext {metadata?:Metadata;options?:CallOptions;signal?:AbortSignal;}
export type RpcUnary<T>=Promise<T>&{readonly call:ClientUnaryCall;readonly headers:Promise<Metadata>;readonly status:Promise<StatusObject>;cancel():void;};
export interface RpcStream<T> extends AsyncIterable<T> {readonly call:ClientReadableStream<T>|ClientDuplexStream<unknown,T>;readonly headers:Promise<Metadata>;readonly status:Promise<StatusObject>;cancel():void;}
function capture(call:ClientUnaryCall|ClientReadableStream<unknown>,signal?:AbortSignal) {
  let resolveHeaders!:(metadata:Metadata)=>void;let resolveStatus!:(status:StatusObject)=>void;
  const headers=new Promise<Metadata>(resolve=>{resolveHeaders=resolve;});
  const status=new Promise<StatusObject>(resolve=>{resolveStatus=resolve;});
  const abort=()=>call.cancel();
  call.on('metadata',resolveHeaders);
  call.on('status',(value:StatusObject)=>{resolveHeaders(new Metadata());resolveStatus(value);signal?.removeEventListener('abort',abort);});
  if(signal?.aborted)call.cancel();else signal?.addEventListener('abort',abort,{once:true});
  return {headers,status,cancel:()=>call.cancel()};
