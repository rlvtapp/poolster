export function stream<O>(call:ClientReadableStream<O>|ClientDuplexStream<unknown,O>,context:RpcContext={}):RpcStream<O> {
  const details=capture(call,context.signal);
  return {call,...details,async *[Symbol.asyncIterator]() {let completed=false;try {for await(const value of call){yield value as O;}completed=true;}finally {if(!completed)call.cancel();}}};
}
async function send<I>(call:ClientWritableStream<I>|ClientDuplexStream<I,unknown>,source:AsyncIterable<I>|Iterable<I>):Promise<void> {
  const iterator=Symbol.asyncIterator in source?source[Symbol.asyncIterator]():source[Symbol.iterator]();
  let rejectClosed!:(error:unknown)=>void;
  const closed=new Promise<never>((_,reject)=>{rejectClosed=reject;});
  // Attach immediately so cancellation while an input iterator is awaiting cannot leak a rejection.
  void closed.catch(()=>{});
  const error=(value:unknown)=>rejectClosed(value);
  const close=()=>rejectClosed(new Error('RPC stream closed before its input completed'));
  call.on('error',error);call.on('close',close);
  let completed=false;
  try {
    while(true) {
      const next=await Promise.race([Promise.resolve(iterator.next()),closed]);
      if(next.done){completed=true;call.end();break;}
      if(!call.write(next.value))await Promise.race([new Promise<void>(resolve=>call.once('drain',resolve)),closed]);
    }
  } finally {
    call.removeListener('error',error);call.removeListener('close',close);
