export function encode<S extends DescMessage>(schema:S,message:MessageShape<S>):Uint8Array {checkDepth(schema,message);const bytes=toBinary(schema,message,{writeUnknownFields:{{RETAIN}}});checkBytes(bytes);return bytes;}
export function decode<S extends DescMessage>(schema:S,bytes:Uint8Array):MessageShape<S> {checkBytes(bytes);const message=fromBinary(schema,bytes,{readUnknownFields:{{RETAIN}},recursionLimit:maxDepth});checkDepth(schema,message);return message;}
