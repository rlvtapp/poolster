#ifndef POOLSTER_KAFKA_H
#define POOLSTER_KAFKA_H
#include <stdint.h>
#include <stddef.h>
typedef struct pk_client pk_client;
typedef struct pk_message pk_message;
typedef struct { const char *name; const unsigned char *value; size_t length; int is_null; } pk_header;
typedef struct { int available; int error; int32_t partition; int64_t offset; uint64_t token; } pk_delivery;
const char *pk_version(void);
pk_client *pk_open(const char *brokers, const char *client_id, const char *group, const char *topic, char *error, size_t size);
const char *pk_name(pk_client *client);
void pk_close(pk_client *client);
int pk_send(pk_client *client, const char *topic, const unsigned char *payload, size_t length,
    const unsigned char *key, size_t key_length, const pk_header *headers, size_t count, uint64_t token);
pk_delivery pk_delivery_poll(pk_client *client);
pk_message *pk_receive(pk_client *client);
int pk_message_error(pk_message *message);
const unsigned char *pk_payload(pk_message *message, size_t *length);
const unsigned char *pk_key(pk_message *message, size_t *length);
int pk_header_at(pk_message *message, size_t index, pk_header *header);
int32_t pk_partition(pk_message *message);
int64_t pk_offset(pk_message *message);
int pk_commit(pk_client *client, pk_message *message);
void pk_message_free(pk_message *message);
const char *pk_error(int error);
#endif
