import Foundation

public enum KafkaError: Error, Sendable {
    case invalid(String)
    case broker(String)
    case closed
}
public struct KafkaDefinition<P: Codable & Sendable, H: Codable & Sendable, K: Codable & Sendable>: Sendable {
    public let topic: String
    public let clientID: String?
    public let group: String?
    let payloadSchema: String
    let headersSchema: String?
    let keySchema: String?
    public init(topic: String, clientID: String? = nil, group: String? = nil,
                payloadSchema: String, headersSchema: String? = nil, keySchema: String? = nil) {
        self.topic = topic; self.clientID = clientID; self.group = group
        self.payloadSchema = payloadSchema; self.headersSchema = headersSchema; self.keySchema = keySchema
    }
    func encode(_ payload: P, _ headers: H?, _ key: K?) throws -> KafkaWire {
        let data = try JSONEncoder().encode(payload)
        try KafkaSchema.validate(try KafkaJSON.parse(data), schema: payloadSchema)
        let headerData = try headers.map { try JSONEncoder().encode($0) } ?? Data("{}".utf8)
        let headerValue = try KafkaJSON.parse(headerData)
        if let schema = headersSchema { try KafkaSchema.validate(headerValue, schema: schema) }
        guard case .object(let object) = headerValue else { throw KafkaError.invalid("Headers must be an object") }
        var values: [String: Data] = [:]
        for (name, value) in object {
            guard case .string(let text) = value else { throw KafkaError.invalid("Headers must be nonnull strings") }
            values[name] = Data(text.utf8)
        }
        var keyData: Data?
        if let key {
            let value = try KafkaJSON.parse(JSONEncoder().encode(key))
            if let schema = keySchema { try KafkaSchema.validate(value, schema: schema) }
            guard case .string(let text) = value else { throw KafkaError.invalid("Key must be a string") }
            keyData = Data(text.utf8)
        }
        return KafkaWire(payload: data, headers: values, key: keyData)
    }
    func decode(_ wire: KafkaWire) throws -> (P, H, K?) {
        let value = try KafkaJSON.parse(wire.payload)
        try KafkaSchema.validate(value, schema: payloadSchema)
        var headers: [String: JSONValue] = [:]
        for (name, data) in wire.headers {
            guard let text = String(data: data, encoding: .utf8) else { throw KafkaError.invalid("Invalid header UTF-8") }
            headers[name] = .string(text)
        }
        let headerValue = JSONValue.object(headers)
        if let schema = headersSchema { try KafkaSchema.validate(headerValue, schema: schema) }
        var key: K?
        if let data = wire.key {
            guard let text = String(data: data, encoding: .utf8) else { throw KafkaError.invalid("Invalid key UTF-8") }
            let value = JSONValue.string(text)
            if let schema = keySchema { try KafkaSchema.validate(value, schema: schema) }
            key = try JSONDecoder().decode(K.self, from: JSONEncoder().encode(value))
        }
        return (try JSONDecoder().decode(P.self, from: wire.payload),
                try JSONDecoder().decode(H.self, from: JSONEncoder().encode(headerValue)), key)
    }
}
struct KafkaWire: Sendable { let payload: Data; let headers: [String: Data]; let key: Data? }

// Foundation decoders otherwise accept duplicate object keys. Scan every object
// before decoding, comparing decoded key strings (including escaped equivalents).
enum KafkaJSON {
    static func parse(_ data: Data) throws -> JSONValue {
        guard String(data: data, encoding: .utf8) != nil else { throw KafkaError.invalid("Invalid payload UTF-8") }
        var scanner = Scanner(bytes: Array(data))
        try scanner.value(depth: 0)
        scanner.whitespace()
        guard scanner.index == scanner.bytes.count else { throw KafkaError.invalid("Trailing JSON") }
        return try JSONDecoder().decode(JSONValue.self, from: data)
    }
    struct Scanner {
        let bytes: [UInt8]; var index = 0
        mutating func whitespace() { while index < bytes.count && [9, 10, 13, 32].contains(bytes[index]) { index += 1 } }
        mutating func expect(_ byte: UInt8) throws {
            whitespace(); guard index < bytes.count && bytes[index] == byte else { throw KafkaError.invalid("Malformed JSON") }; index += 1
        }
        mutating func string() throws -> String {
            whitespace(); let start = index; try expect(34)
            while index < bytes.count {
                let byte = bytes[index]; index += 1
                if byte == 34 { return try JSONDecoder().decode(String.self, from: Data(bytes[start..<index])) }
                if byte == 92 { guard index < bytes.count else { break }; index += 1 }
            }
            throw KafkaError.invalid("Unterminated JSON string")
        }
        mutating func value(depth: Int) throws {
            guard depth <= 128 else { throw KafkaError.invalid("JSON depth exceeds 128") }
            whitespace(); guard index < bytes.count else { throw KafkaError.invalid("Missing JSON value") }
            switch bytes[index] {
            case 34: _ = try string()
            case 123:
                index += 1; whitespace(); var keys = Set<String>()
                if index < bytes.count && bytes[index] == 125 { index += 1; return }
                while true {
                    let key = try string(); guard keys.insert(key).inserted else { throw KafkaError.invalid("Duplicate JSON property") }
                    try expect(58); try value(depth: depth + 1); whitespace()
                    if index < bytes.count && bytes[index] == 125 { index += 1; break }
                    try expect(44)
                }
            case 91:
                index += 1; whitespace()
                if index < bytes.count && bytes[index] == 93 { index += 1; return }
                while true {
                    try value(depth: depth + 1); whitespace()
                    if index < bytes.count && bytes[index] == 93 { index += 1; break }
                    try expect(44)
                }
            default:
                let start = index
                while index < bytes.count && ![9, 10, 13, 32, 44, 93, 125].contains(bytes[index]) { index += 1 }
                guard index > start else { throw KafkaError.invalid("Malformed JSON value") }
            }
        }
    }
}
