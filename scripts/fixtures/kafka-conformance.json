{
  "schema_version": 1,
  "broker": {
    "compose": "crates/plugins/typescript/tests/fixtures/kafka-broker.compose.yaml",
    "default_address": "127.0.0.1:29092",
    "scope": "plaintext Kafka JSON subset; local tests only"
  },
  "cases": [
    {
      "id": "package",
      "requirement": "Generated package compiles using pinned native dependencies."
    },
    {
      "id": "roundtrip",
      "requirement": "Payload, key and headers survive a real broker round trip."
    },
    {
      "id": "outgoing-validation",
      "requirement": "Invalid outgoing schema data is rejected before publication."
    },
    {
      "id": "incoming-validation",
      "requirement": "Malformed or schema-invalid incoming records are reported."
    },
    {
      "id": "utf8",
      "requirement": "Malformed UTF-8 in payload, key and headers is rejected."
    },
    {
      "id": "acknowledgement",
      "requirement": "Acknowledgement follows the documented native policy; no universal manual-ack promise."
    },
    {
      "id": "handler-replay",
      "requirement": "Failed handler leaves the offset uncommitted and reopening the same group redelivers it."
    },
    {
      "id": "cancellation",
      "requirement": "The documented cancellation mechanism terminates consumption; does not retract sends."
    },
    {
      "id": "bindings",
      "requirement": "Operation group and client IDs are honored; conflicting fixed group overrides rejected."
    },
    {
      "id": "provenance",
      "requirement": "Shared-model generation rejects stale selected contract revisions."
    },
    {
      "id": "regeneration",
      "requirement": "Provider substitution/regeneration produce deterministic bounded source files."
    }
  ],
  "languages": {
